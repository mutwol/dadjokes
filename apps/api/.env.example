# Copy to .env for local development. Values here match docker-compose.yml.
NODE_ENV=development
PORT=3000
# The web app's origin, for CORS and cookies.
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://daddy:daddy@localhost:5432/daddy_jokes
REDIS_URL=redis://localhost:6379

# Generate each with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-0123456789
CODE_SECRET=change-me-to-another-long-random-string-0123

# Optional: enables POST /v1/auth/google
GOOGLE_CLIENT_ID=

# Outgoing email. Mailpit from docker-compose catches it at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Daddy Jokes <hello@daddyjokes.local>"

# Uploaded images. "local" stores them in UPLOAD_DIR and the API serves them at /media.
# For S3, Cloudflare R2 or MinIO set STORAGE_DRIVER=s3 and the S3_* values, and point
# MEDIA_BASE_URL at the bucket's public URL or CDN.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MEDIA_BASE_URL=/media
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Web Push. Generate a pair with: pnpm --filter api push:keys
# Leave both empty to switch push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@daddyjokes.local

# M-Pesa. "fake" works offline: tips and payouts settle after a few seconds
# (phones ending 0000 fail, 1111 cancel). For "sandbox" or "production" fill in
# your Daraja app's keys. MPESA_CALLBACK_BASE_URL must be the API's public https URL.
MPESA_MODE=fake
# Fake mode: "prompt" shows a simulated M-Pesa prompt in the app; "auto" settles by itself (0000 fails, 1111 cancels).
MPESA_FAKE_SETTLE=prompt
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# MPESA_CALLBACK_BASE_URL=https://daddyjokes.example.com
# MPESA_B2C_SHORTCODE=
# MPESA_B2C_INITIATOR=
# MPESA_B2C_SECURITY_CREDENTIAL=
# Default platform cut; admins add other rates (per writer too) in the finance console.
TIP_FEE_PERCENT=10
# Earnings stay pending this long before they can be withdrawn.
TIP_HOLD_HOURS=72
PAYOUT_MIN_KES=100
