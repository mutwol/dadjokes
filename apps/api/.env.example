# Copy to .env for local development. Values here match docker-compose.yml.
NODE_ENV=development
PORT=3000
# The web app's origin, for CORS and cookies.
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://daddy:daddy@localhost:5432/daddy_jokes
REDIS_URL=redis://localhost:6379

# Generate each with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-0123456789
CODE_SECRET=change-me-to-another-long-random-string-0123

# Optional: enables POST /v1/auth/google
GOOGLE_CLIENT_ID=

# Outgoing email. Mailpit from docker-compose catches it at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Daddy Jokes <hello@daddyjokes.local>"

# Uploaded images. "local" stores them in UPLOAD_DIR and the API serves them at /media.
# For S3, Cloudflare R2 or MinIO set STORAGE_DRIVER=s3 and the S3_* values, and point
# MEDIA_BASE_URL at the bucket's public URL or CDN.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MEDIA_BASE_URL=/media
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
