# Serves the web app and proxies the API on one origin, so cookies and
# CORS stay simple. Caddy gets and renews the HTTPS certificate for $DOMAIN.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# The API, including live counts (server-sent events: don't buffer).
	handle /v1/* {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}
	# Uploaded images when STORAGE_DRIVER=local, and the health check.
	handle /media/* {
		reverse_proxy api:3000
	}
	handle /health {
		reverse_proxy api:3000
	}

	# The service worker must always be fresh, or push changes never reach browsers.
	handle /sw.js {
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}

	# Hashed build files can be cached forever; everything else falls back to the app.
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
