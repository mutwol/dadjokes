{
  "name": "daddy-jokes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api run \"/^dev/\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:worker": "pnpm --filter api dev:worker",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres redis mailpit && docker compose run --rm --build migrate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "contracts": "pnpm --filter api openapi && pnpm --filter @daddy-jokes/contracts generate",
    "db:down": "docker compose down"
  }
}
