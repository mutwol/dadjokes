{
  "name": "@daddy-jokes/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed client for the Daddy Jokes API, generated from the API's OpenAPI spec.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts --default-non-nullable false",
    "lint": "tsc --noEmit",
    "check": "openapi-typescript openapi.json -o src/schema.d.ts --default-non-nullable false --check"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  }
}
