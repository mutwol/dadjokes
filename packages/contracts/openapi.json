                "schema": {
                  "$ref": "#/components/schemas/Creator"
                }
              }
            }
          },
          "404": {
            "description": "No writer with that handle",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "A writer's public profile",
        "tags": [
          "creators"
        ]
      }
    },
    "/v1/me/subscriptions": {
      "get": {
        "operationId": "listMySubscriptions",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
