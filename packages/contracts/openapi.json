    "/v1/creators": {
      "get": {
        "operationId": "listCreators",
        "parameters": [
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "default": "popular",
              "type": "string",
              "enum": [
                "popular",
                "new"
              ]
            }
          },
          {
            "name": "country",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 56
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatorPage"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List writers, most subscribed first by default",
        "tags": [
          "creators"
        ]
      }
    },
    "/v1/creators/{handle}": {
      "get": {
        "operationId": "getCreator",
