            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Turn reading and writing on or off",
        "tags": [
          "me"
        ]
      }
    },
    "/v1/me/preferences": {
      "patch": {
        "operationId": "updateMyPreferences",
        "parameters": [],
