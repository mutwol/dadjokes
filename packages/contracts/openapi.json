              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatorList"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Writers I subscribe to",
        "tags": [
          "subscriptions"
        ]
      }
    },
    "/v1/me/subscriptions/{creatorId}": {
      "put": {
        "operationId": "subscribe",
        "parameters": [
          {
            "name": "creatorId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Subscribed"
          },
          "404": {
            "description": "No writer with that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Tried to subscribe to yourself",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Subscribe to a writer. Safe to repeat.",
        "tags": [
          "subscriptions"
        ]
      },
      "delete": {
        "operationId": "unsubscribe",
        "parameters": [
          {
            "name": "creatorId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Unsubscribed"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Unsubscribe from a writer. Safe to repeat.",
        "tags": [
          "subscriptions"
        ]
      }
    },
    "/v1/auth/email/start": {
      "post": {
        "operationId": "startEmailSignIn",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartEmailRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Code sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartEmailResponse"
                }
              }
            }
          },
          "429": {
            "description": "Asked too soon or too often (codes: resend_too_soon, too_many_codes)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "summary": "Email a 6-digit sign-in code",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/email/verify": {
      "post": {
        "operationId": "verifyEmailSignIn",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Wrong or expired code (codes: code_invalid, code_expired)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many wrong tries (code: code_locked)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "summary": "Exchange the code for a session",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/google": {
      "post": {
        "operationId": "googleSignIn",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleSignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Token rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "summary": "Sign in with a Google ID token",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            }
          },
          "401": {
            "description": "Signed out or expired (code: session_expired)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "dj_refresh": []
          }
        ],
        "summary": "New access token from the refresh cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Signed out"
          }
        },
        "security": [
          {
            "dj_refresh": []
          }
        ],
        "summary": "Sign out this device",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "Daddy Jokes API",
    "description": "One dad joke a day. Errors use RFC 9457 problem details with a stable `code`. Send the access token as `Authorization: Bearer <token>`; refresh it with POST /v1/auth/refresh.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "dj_refresh"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
      "Preferences": {
        "type": "object",
        "properties": {
          "deliveryHour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "jokeOrigin": {
            "type": "string",
            "enum": [
              "everywhere",
              "local"
            ]
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "deliveryHour",
          "jokeOrigin",
          "topics"
        ]
      },
      "Payout": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "mpesa"
            ]
          },
          "phoneLast3": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "method",
          "phoneLast3",
          "verified"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "name": {
            "nullable": true,
            "type": "string"
          },
          "handle": {
            "nullable": true,
            "type": "string"
          },
          "country": {
            "nullable": true,
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "tone": {
            "type": "string",
            "enum": [
              "red",
              "navy",
              "yellow",
              "green",
              "denim"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "reader",
                "writer",
                "curator",
                "admin"
              ]
            }
          },
          "preferences": {
            "$ref": "#/components/schemas/Preferences"
          },
          "payout": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Payout"
              }
            ]
          },
          "onboarded": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "handle",
          "country",
          "bio",
          "tone",
          "timezone",
          "roles",
          "preferences",
          "payout",
          "onboarded",
          "createdAt"
        ]
      },
      "UpdateMeRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "handle": {
            "type": "string",
            "pattern": "^[a-z0-9_]{3,20}$"
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 56
          },
          "bio": {
            "type": "string",
            "maxLength": 80
          },
          "timezone": {
            "type": "string"
          }
        }
      },
      "ReplaceRolesRequest": {
        "type": "object",
        "properties": {
          "roles": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "reader",
                "writer"
              ]
            }
          }
        },
        "required": [
          "roles"
        ]
      },
      "UpdatePreferencesRequest": {
        "type": "object",
        "properties": {
          "deliveryHour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "jokeOrigin": {
            "type": "string",
            "enum": [
              "everywhere",
              "local"
            ]
          },
          "topics": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PayoutMethodRequest": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "mpesa"
            ]
          },
          "phone": {
            "type": "string"
          }
        },
        "required": [
          "method",
          "phone"
        ]
      },
      "CompleteOnboardingRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "handle": {
            "type": "string",
            "pattern": "^[a-z0-9_]{3,20}$"
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 56
          },
          "bio": {
            "default": "",
            "type": "string",
            "maxLength": 80
          },
          "timezone": {
            "type": "string"
          },
          "roles": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
