              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Delivery hour, joke origin and topics",
        "tags": [
          "me"
        ]
      }
    },
    "/v1/me/payout-method": {
      "put": {
        "operationId": "setMyPayoutMethod",
